# Browser-facing backend URL. This value is intentionally public.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# Local PostgreSQL connection. Replace with managed credentials in production.
DATABASE_URL=postgresql+psycopg://civicfix:civicfix@localhost:5432/civicfix

# Server-only credential and model used for structured report analysis.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
